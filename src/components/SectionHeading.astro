---
import { sitePath } from '@/utils/url';
interface Props {
  title: string;
  href?: string;
  linkLabel?: string;
}
const { title, href, linkLabel = 'View all' } = Astro.props;
---

<div class="section-heading">
  <h2>{title}</h2>
  {href && (
    <a class="text-link" href={sitePath(href)}>
      {linkLabel} <span aria-hidden="true">→</span>
    </a>
  )}
</div>
