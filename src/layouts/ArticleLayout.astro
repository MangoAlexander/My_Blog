---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, readingTime } from '@/utils/content';
import { sitePath } from '@/utils/url';
import site from '@/data/site.json';
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  post: CollectionEntry<'writing'>;
  headings: Heading[];
  previous?: CollectionEntry<'writing'>;
  next?: CollectionEntry<'writing'>;
  related: CollectionEntry<'writing'>[];
}
const { post, headings, previous, next, related } = Astro.props;
const time = readingTime(post.body ?? '');
const title = `${post.data.title} — ${site.name}`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { '@type': 'Person', name: site.author },
  image: new URL(sitePath(post.data.cover), Astro.site ?? site.url).href,
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site ?? site.url).href,
};
---

<BaseLayout
  title={title}
  description={post.data.description}
  image={post.data.cover}
  type="article"
  structuredData={structuredData}
>
  <div class="reading-progress" aria-hidden="true">
    <span></span>
  </div>
  <article>
    <header class="article-header container">
      <div class="article-kicker">
        <span class="eyebrow">Essay</span>
        <span class="meta">{time.text}</span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      <div class="article-details">
        <div>
          <span class="meta">Published</span>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        </div>
        {post.data.updated && (
          <div>
            <span class="meta">Updated</span>
            <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time>
          </div>
        )}
        <div>
          <span class="meta">Filed under</span>
          <div class="tag-list">
            {post.data.tags.map((tag) => (
              <a
                class="tag"
                href={sitePath(
                  `/tags/${encodeURIComponent(tag.toLocaleLowerCase().replace(/\s+/g, '-'))}/`,
                )}
              >
                {tag}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>
    <div class="cover container">
      <img src={sitePath(post.data.cover)} alt={post.data.coverAlt} width="1600" height="960" />
    </div>
    {headings.length > 0 && (
      <details class="mobile-toc reading-width">
        <summary>On this page</summary>
        <ol>
          {headings
            .filter((h) => h.depth <= 3)
            .map((heading) => (
              <li class={`depth-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
        </ol>
      </details>
    )}
    <div class="article-grid container">
      <div class="prose">
        <slot />
      </div>
      {headings.length > 0 && (
        <aside class="toc" aria-label="Table of contents">
          <p class="meta">On this page</p>
          <ol>
            {headings
              .filter((h) => h.depth <= 3)
              .map((heading) => (
                <li class={`depth-${heading.depth}`}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
          </ol>
        </aside>
      )}
    </div>
  </article>
  <nav class="post-nav container" aria-label="Adjacent articles">
    <div>
      {previous && (
        <>
          <span class="meta">Previous</span>
          <a href={sitePath(`/writing/${previous.data.slug}/`)}>
            {previous.data.title} <span>←</span>
          </a>
        </>
      )}
    </div>
    <div>
      {next && (
        <>
          <span class="meta">Next</span>
          <a href={sitePath(`/writing/${next.data.slug}/`)}>
            {next.data.title} <span>→</span>
          </a>
        </>
      )}
    </div>
  </nav>
  {related.length > 0 && (
    <section class="related section">
      <div class="container">
        <p class="eyebrow">Continue reading</p>
        <div class="related-grid">
          {related.map((item) => (
            <a href={sitePath(`/writing/${item.data.slug}/`)}>
              <span class="meta">{formatDate(item.data.date)}</span>
              <h2>{item.data.title}</h2>
              <p>{item.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
<script>
  const bar = document.querySelector<HTMLElement>('.reading-progress span');
  const article = document.querySelector('article');
  const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const update = () => {
    if (bar && article) {
      const start = article.offsetTop;
      const distance = article.offsetHeight - innerHeight;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, (scrollY - start) / distance))})`;
    }
    let active = '';
    for (const link of tocLinks) {
      const node = document.querySelector(link.hash);
      if (node && node.getBoundingClientRect().top < 180) active = link.hash;
    }
    tocLinks.forEach((link) => link.toggleAttribute('aria-current', link.hash === active));
  };
  addEventListener('scroll', update, { passive: true });
  update();
</script>
<style>
  .reading-progress {
    position: fixed;
    z-index: 80;
    top: 0;
    right: 0;
    left: 0;
    height: 2px;
  }
  .reading-progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .article-header {
    padding-block: clamp(5rem, 11vw, 9rem);
  }
  .article-kicker {
    display: flex;
    justify-content: space-between;
  }
  .article-header h1 {
    max-width: 14ch;
    margin: 1rem 0 1.7rem;
    font-family: var(--serif);
    font-size: clamp(3rem, 7.6vw, 7.4rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.94;
    text-wrap: balance;
  }
  .article-description {
    max-width: 48rem;
    color: var(--muted-foreground);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
  }
  .article-details {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem 4rem;
    margin-top: 3.5rem;
  }
  .article-details > div {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
  }
  .cover {
    overflow: hidden;
  }
  .cover img {
    width: 100%;
    aspect-ratio: 5 / 3;
    object-fit: cover;
  }
  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--reading)) 13rem;
    gap: clamp(3rem, 9vw, 9rem);
    justify-content: center;
    padding-block: clamp(4rem, 9vw, 8rem);
  }
  .toc {
    position: sticky;
    top: 7rem;
    align-self: start;
    max-height: calc(100vh - 9rem);
    overflow-y: auto;
  }
  .toc ol,
  .mobile-toc ol {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .toc li {
    margin: 0.65rem 0;
    line-height: 1.3;
  }
  .toc li.depth-3 {
    padding-left: 0.8rem;
  }
  .toc a {
    color: var(--muted-foreground);
    font-size: 0.74rem;
  }
  .toc a:hover,
  .toc a[aria-current] {
    color: var(--accent);
  }
  .mobile-toc {
    display: none;
    margin-top: 2rem;
    padding: 1rem 0;
    border-block: 1px solid var(--border);
  }
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-block: 3rem 6rem;
    border-top: 1px solid var(--border);
  }
  .post-nav > div {
    display: grid;
    gap: 0.5rem;
  }
  .post-nav > div:last-child {
    text-align: right;
  }
  .post-nav a {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.5vw, 1.8rem);
  }
  .post-nav a:hover {
    color: var(--accent);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 2rem;
  }
  .related-grid a {
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .related-grid h2 {
    margin: 1rem 0 0.7rem;
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.1;
  }
  .related-grid p {
    max-width: 34rem;
    color: var(--muted-foreground);
    font-size: 0.86rem;
  }
  .related-grid a:hover h2 {
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: minmax(0, var(--reading));
    }
    .toc {
      display: none;
    }
    .mobile-toc {
      display: block;
    }
  }
  @media (max-width: 650px) {
    .article-details {
      gap: 1.5rem 2.5rem;
    }
    .post-nav,
    .related-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .post-nav > div:last-child {
      text-align: left;
    }
  }
</style>
