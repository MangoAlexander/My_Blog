---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Content Studio — Quiet Signal"
  description="Private gateway to the repository-backed content editor."
  noindex
>
  <section class="admin-shell container">
    <div class="admin-mark" aria-hidden="true">
      Q<span>+</span>
    </div>
    <div class="admin-copy">
      <p class="eyebrow">Content studio</p>
      <h1>
        Write <em>anywhere.</em>
      </h1>
      <p>
        Create and publish essays, notes, and projects from your browser. Every change is saved to
        the same Git repository as the site.
      </p>
      <a class="admin-button" href="https://app.pagescms.org" rel="noreferrer">
        Continue with GitHub <span aria-hidden="true">→</span>
      </a>
      <small>
        Repository-backed · No separate content database
        <br />
        Access requires GitHub write permission.
      </small>
    </div>
  </section>
</BaseLayout>
<style>
  .admin-shell {
    display: grid;
    grid-template-columns: 0.75fr 1fr;
    gap: clamp(4rem, 12vw, 12rem);
    align-items: center;
    min-height: calc(100vh - 10rem);
    padding-block: 5rem;
  }
  .admin-mark {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    font-family: var(--serif);
    font-size: clamp(6rem, 18vw, 14rem);
  }
  .admin-mark span {
    position: absolute;
    right: 12%;
    bottom: 12%;
    display: grid;
    width: 2.8rem;
    height: 2.8rem;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-contrast);
    font: 1.3rem var(--sans);
  }
  h1 {
    margin: 0.5rem 0 1.5rem;
    font-family: var(--serif);
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }
  h1 em {
    color: var(--accent);
    font-weight: 400;
  }
  .admin-copy > p:not(.eyebrow) {
    max-width: 34rem;
    color: var(--muted-foreground);
    font-size: 1.1rem;
  }
  .admin-button {
    display: inline-flex;
    gap: 3rem;
    align-items: center;
    margin: 2rem 0;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--foreground);
    font-size: 0.82rem;
    transition:
      background 180ms,
      color 180ms;
  }
  .admin-button:hover {
    background: var(--foreground);
    color: var(--background);
  }
  small {
    display: block;
    color: var(--muted-foreground);
    font-size: 0.7rem;
  }
  @media (max-width: 700px) {
    .admin-shell {
      grid-template-columns: 1fr;
    }
    .admin-mark {
      width: 12rem;
    }
    .admin-mark span {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
