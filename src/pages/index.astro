---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ArticleRow from '@/components/ArticleRow.astro';
import now from '@/data/now.json';
import site from '@/data/site.json';
import { byDateDesc, filterPublished, formatDate } from '@/utils/content';
import { sitePath } from '@/utils/url';

const posts = filterPublished(await getCollection('writing')).sort(byDateDesc);
const notes = filterPublished(await getCollection('notes')).sort(byDateDesc);
const projects = (await getCollection('projects'))
  .filter((entry) => !entry.data.draft)
  .sort((a, b) => b.data.year - a.data.year);
const featured = posts.find((post) => post.data.featured) ?? posts[0];
---

<BaseLayout>
  <section class="hero container">
    <p class="eyebrow">Independent journal · {new Date().getFullYear()}</p>
    <h1 class="display">
      {site.heroText.split('\n').map((line) => (
        <span>{line}</span>
      ))}
    </h1>
    <div class="hero-foot">
      <p>{site.heroSubtitle}</p>
      <div class="hero-links">
        <a href={sitePath('/writing')}>
          Read the writing <span>→</span>
        </a>
        <a href={sitePath('/about')}>About this place</a>
      </div>
    </div>
  </section>

  {featured && (
    <section class="section">
      <div class="container">
        <SectionHeading title="Featured writing" href="/writing" />
        <a class="feature" href={sitePath(`/writing/${featured.data.slug}/`)}>
          <div class="feature-image">
            <img
              src={sitePath(featured.data.cover)}
              alt={featured.data.coverAlt}
              width="1600"
              height="960"
            />
          </div>
          <div class="feature-copy">
            <p class="meta">
              <time datetime={featured.data.date.toISOString()}>
                {formatDate(featured.data.date)}
              </time>{' '}
              · Essay
            </p>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <span class="feature-action">
              Read essay <i aria-hidden="true">↗</i>
            </span>
          </div>
        </a>
      </div>
    </section>
  )}

  <section class="section editorial-section">
    <div class="container editorial-grid">
      <a class="editorial-cell now-cell" href={sitePath('/now')}>
        <p class="eyebrow">Now</p>
        <h2>What has my attention.</h2>
        <p>{now.building[0]}</p>
        <span class="meta">Updated {formatDate(now.updated)}</span>
      </a>
      <a class="editorial-cell project-cell" href={sitePath(`/projects/${projects[0].data.slug}/`)}>
        <p class="eyebrow">Selected project · {projects[0].data.year}</p>
        <h2>{projects[0].data.name}</h2>
        <p>{projects[0].data.description}</p>
        <span class="text-link">
          View project <span>→</span>
        </span>
      </a>
      <div class="editorial-cell note-cell">
        <p class="eyebrow">Field note · {formatDate(notes[0].data.date)}</p>
        <blockquote>“{notes[0].body?.trim()}”</blockquote>
        <a class="text-link" href={sitePath('/notes')}>
          More notes <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading title="Recent writing" href="/archive" linkLabel="Browse archive" />
      <ol class="rule-list">
        {posts.slice(featured === posts[0] ? 1 : 0, 5).map((post) => (
          <li>
            <ArticleRow post={post} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section notes-strip">
    <div class="container">
      <SectionHeading title="From the notebook" href="/notes" />
      <div class="note-grid">
        {notes.slice(0, 3).map((note, index) => (
          <a href={sitePath(`/notes/${note.data.slug}/`)}>
            <span class="meta">
              0{index + 1} · {formatDate(note.data.date)}
            </span>
            <h3>{note.data.title}</h3>
            <p>{note.body?.trim()}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    min-height: calc(100svh - 4.6rem);
    flex-direction: column;
    justify-content: center;
    padding-block: 6rem 4rem;
  }
  .display span {
    display: block;
  }
  .display span:last-child {
    margin-left: clamp(0rem, 9vw, 8rem);
    font-style: italic;
  }
  .hero-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
    margin-top: clamp(3rem, 8vw, 7rem);
  }
  .hero-foot > p {
    max-width: 31rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 1.05rem;
  }
  .hero-links {
    display: flex;
    justify-content: flex-end;
    gap: 2rem;
    font-size: 0.82rem;
  }
  .hero-links a:first-child {
    color: var(--accent);
  }
  .hero-links span {
    display: inline-block;
    transition: transform 180ms ease;
  }
  .hero-links a:hover span {
    transform: translateX(0.25rem);
  }
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .feature-image {
    overflow: hidden;
    background: var(--muted);
  }
  .feature-image img {
    aspect-ratio: 5 / 3;
    object-fit: cover;
    transition: transform 450ms ease-out;
  }
  .feature:hover img {
    transform: scale(1.012);
  }
  .feature-copy h2 {
    margin: 0.8rem 0 1rem;
    font-family: var(--serif);
    font-size: clamp(2.3rem, 5vw, 4.7rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .feature-copy > p:not(.meta) {
    color: var(--muted-foreground);
  }
  .feature-action {
    display: inline-block;
    margin-top: 1.2rem;
    color: var(--accent);
    font-size: 0.83rem;
    font-weight: 600;
  }
  .feature-action i {
    display: inline-block;
    font-style: normal;
    transition: transform 180ms ease;
  }
  .feature:hover .feature-action i {
    transform: translate(0.2rem, -0.2rem);
  }
  .editorial-section {
    padding-block: 0;
    border-top: 0;
  }
  .editorial-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    grid-template-rows: auto auto;
    padding: 0;
    border: 1px solid var(--border);
  }
  .editorial-cell {
    min-height: 22rem;
    padding: clamp(1.7rem, 4vw, 3.5rem);
    transition: background 200ms ease;
  }
  a.editorial-cell:hover {
    background: var(--muted);
  }
  .editorial-cell h2 {
    max-width: 12ch;
    margin: 0 0 1.25rem;
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }
  .editorial-cell > p:not(.eyebrow) {
    max-width: 31rem;
    color: var(--muted-foreground);
  }
  .now-cell {
    grid-row: span 2;
    border-right: 1px solid var(--border);
  }
  .now-cell .meta {
    display: block;
    margin-top: 7rem;
  }
  .project-cell {
    border-bottom: 1px solid var(--border);
  }
  .note-cell {
    min-height: 17rem;
  }
  blockquote {
    max-width: 37rem;
    margin: 0 0 2rem;
    font-family: var(--serif);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    line-height: 1.35;
  }
  .note-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--border);
  }
  .note-grid a {
    min-height: 15rem;
    padding: 1.6rem 1.6rem 1.6rem 0;
    border-right: 1px solid var(--border);
  }
  .note-grid a + a {
    padding-left: 1.6rem;
  }
  .note-grid a:last-child {
    border-right: 0;
  }
  .note-grid h3 {
    margin: 2rem 0 0.7rem;
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1.15;
  }
  .note-grid p {
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.9rem;
  }
  .note-grid a:hover h3 {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .hero {
      min-height: 80svh;
    }
    .display span:last-child {
      margin-left: 0;
    }
    .hero-foot,
    .feature {
      grid-template-columns: 1fr;
    }
    .hero-links {
      justify-content: flex-start;
    }
    .feature-copy {
      order: -1;
    }
    .editorial-grid {
      grid-template-columns: 1fr;
      margin-inline: var(--space-page);
    }
    .editorial-cell {
      min-height: 18rem;
    }
    .now-cell {
      grid-row: auto;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
    .now-cell .meta {
      margin-top: 3rem;
    }
    .note-grid {
      grid-template-columns: 1fr;
    }
    .note-grid a,
    .note-grid a + a {
      min-height: auto;
      padding: 1.5rem 0;
      border-right: 0;
      border-bottom: 1px solid var(--border);
    }
  }
</style>
