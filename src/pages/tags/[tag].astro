---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleRow from '@/components/ArticleRow.astro';
import { byDateDesc, filterPublished, tagSlug } from '@/utils/content';
export async function getStaticPaths() {
  const posts = filterPublished(await getCollection('writing'));
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)).sort(byDateDesc) },
  }));
}
const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag} — Quiet Signal`} description={`Writing filed under ${tag}.`}>
  <header class="page-shell container">
    <p class="eyebrow">Tag</p>
    <h1 class="page-title">#{tag}</h1>
    <p class="lede">
      {posts.length} {posts.length === 1 ? 'piece' : 'pieces'} in this thread.
    </p>
  </header>
  <section class="section container">
    <ol class="rule-list">
      {posts.map((post) => (
        <li>
          <ArticleRow post={post} />
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
